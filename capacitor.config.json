{
  "appId": "app.samas.broker",
  "appName": "SAMAS",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#000000",
      "showSpinner": false,
      "splashImmersive": true,
      "launchShowDuration": 0,
      "fadeOutDuration": 200
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#000000",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false
  }
}
